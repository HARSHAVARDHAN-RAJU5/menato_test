{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "_managed_by": "memanto",
            "type": "command",
            "command": "C:/Users/ADMIN/AppData/Local/Programs/Python/Python310/python.exe",
            "args": [
              "C:/Users/ADMIN/AppData/Local/Programs/Python/Python310/lib/site-packages/memanto/cli/connect/assets/hooks/session_start.py"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "_managed_by": "memanto",
            "type": "command",
            "command": "C:/Users/ADMIN/AppData/Local/Programs/Python/Python310/python.exe",
            "args": [
              "-m",
              "memanto",
              "memory",
              "sync",
              "--project-dir",
              "E:/Project/memanto-test"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "_managed_by": "memanto",
            "type": "command",
            "if": "Bash(memanto *)",
            "command": "C:/Users/ADMIN/AppData/Local/Programs/Python/Python310/python.exe",
            "args": [
              "C:/Users/ADMIN/AppData/Local/Programs/Python/Python310/lib/site-packages/memanto/cli/connect/assets/hooks/notify.py"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
