{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "_managed_by": "memanto",
            "type": "command",
            "command": "\"C:/Users/ADMIN/AppData/Local/Programs/Python/Python310/python.exe\" -m memanto memory sync --project-dir .",
            "timeout": 30,
            "statusMessage": "Loading MEMANTO memory..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "_managed_by": "memanto",
            "type": "command",
            "command": "\"C:/Users/ADMIN/AppData/Local/Programs/Python/Python310/python.exe\" -m memanto memory sync --project-dir .",
            "timeout": 30,
            "statusMessage": "Saving MEMANTO memory..."
          }
        ]
      }
    ]
  }
}
